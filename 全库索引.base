filters:
  and:
    - file.ext == "md"
views:
  - type: table
    name: 全库
    order:
      - file.name
      - 类型
      - 文档状态
      - 故事线
      - 时代
      - 状态
      - file.folder
    sort:
      - property: file.folder
        direction: ASC

  - type: table
    name: 近期改动
    order:
      - file.name
      - 类型
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
    limit: 40

  - type: table
    name: 待补
    filters:
      and:
        - 文档状态 == "待补"
    order:
      - file.name
      - 类型
      - 故事线
      - 时代
      - file.folder
    sort:
      - property: file.folder
        direction: ASC

  - type: table
    name: 骨架
    filters:
      and:
        - 文档状态 == "骨架"
    order:
      - file.name
      - 类型
      - 故事线
      - file.folder
    sort:
      - property: file.folder
        direction: ASC

  - type: table
    name: 词条·按时代
    filters:
      and:
        - 类型 == "词条"
    order:
      - file.name
      - 故事线
      - 时代
      - 状态
      - file.folder
    sort:
      - property: 时代
        direction: ASC

  - type: table
    name: 按故事线
    filters:
      and:
        - 类型 == "词条"
    order:
      - file.name
      - 故事线
      - 时代
      - file.folder
    groupBy:
      property: 故事线
      direction: ASC

  - type: table
    name: 主题
    filters:
      and:
        - file.hasTag("主题")
    order:
      - file.name
      - tags
      - 故事线
      - file.folder
    sort:
      - property: file.name
        direction: ASC

  - type: table
    name: 草稿与存档
    filters:
      or:
        - 类型 == "草稿"
        - 文档状态 == "存档"
    order:
      - file.name
      - 类型
      - 文档状态
      - file.folder
    sort:
      - property: file.folder
        direction: ASC
